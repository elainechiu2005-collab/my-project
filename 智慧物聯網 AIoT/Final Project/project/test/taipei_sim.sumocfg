<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <input>
        <net-file value="taipei.net.xml"/>
        <route-files value="vehicles.rou.xml"/>
		<gui-settings-file value="gui-settings.cfg"/>
    </input>
    <time>
        <begin value="0"/>
        <end value="3600"/>
        <step-length value="1.0"/>
    </time>
    <processing>
        <ignore-route-errors value="true"/>
    </processing>
    <gui_only>
        <start value="true"/>
        <delay value="100"/>
    </gui_only>
</configuration>